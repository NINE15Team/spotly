{:format :v3,
 :transitions
 [{:name :transition/request-payment,
   :actor :actor.role/customer,
   :actions
   [{:name :action/update-protected-data}
    {:name :action/create-pending-booking, :config {:type :time}}
    {:name :action/privileged-set-line-items}
    {:name :action/stripe-create-payment-intent}],
   :to :state/pending-payment,
   :privileged? true}
  {:name :transition/expire-payment,
   :at
   {:fn/plus
    [{:fn/timepoint [:time/first-entered-state :state/pending-payment]}
     {:fn/period ["PT15M"]}]},
   :actions
   [{:name :action/calculate-full-refund}
    {:name :action/stripe-refund-payment}
    {:name :action/decline-booking}],
   :from :state/pending-payment,
   :to :state/payment-expired}
  {:name :transition/confirm-payment,
   :actor :actor.role/customer,
   :actions [{:name :action/stripe-confirm-payment-intent}],
   :from :state/pending-payment,
   :to :state/payment-confirmed}
  {:name :transition/abort-subscription,
   :actor :actor.role/operator,
   :actions
   [{:name :action/calculate-full-refund}
    {:name :action/stripe-refund-payment}
    {:name :action/decline-booking}],
   :from :state/payment-confirmed,
   :to :state/cancelled,
   :privileged? true}
  ;; Provider approves the subscription request (captures the first payment).
  {:name :transition/accept-subscription,
   :actor :actor.role/provider,
   :actions
   [{:name :action/accept-booking}
    {:name :action/stripe-capture-payment-intent}],
   :from :state/payment-confirmed,
   :to :state/active}
  ;; Provider rejects the subscription request (refunds the first payment).
  {:name :transition/decline-subscription,
   :actor :actor.role/provider,
   :actions
   [{:name :action/calculate-full-refund}
    {:name :action/stripe-refund-payment}
    {:name :action/decline-booking}],
   :from :state/payment-confirmed,
   :to :state/cancelled}
  ;; Acceptance window: expire & refund if the provider does not respond.
  ;; Fires at the earliest of (entered payment-confirmed + 6 days) or booking start.
  ;; BUG FIX: Previously used fn/min with booking-start, which caused immediate expiry because
  ;; booking-start for subscription-rental is always set to "today" at payment time.
  ;; Now uses a fixed 6-day window from entering payment-confirmed, giving the merchant time to respond.
  {:name :transition/expire-acceptance,
   :at
   {:fn/plus
    [{:fn/timepoint [:time/first-entered-state :state/payment-confirmed]}
     {:fn/period ["P6D"]}]},
   :actions
   [{:name :action/calculate-full-refund}
    {:name :action/stripe-refund-payment}
    {:name :action/decline-booking}],
   :from :state/payment-confirmed,
   :to :state/expired}
  ;; Operator-accept fallback (Console / server on behalf of the provider).
  {:name :transition/confirm-subscription,
   :actor :actor.role/operator,
   :actions
   [{:name :action/accept-booking}
    {:name :action/stripe-capture-payment-intent}],
   :from :state/payment-confirmed,
   :to :state/active,
   :privileged? true}
  {:name :transition/extend-subscription,
   :actor :actor.role/operator,
   :actions [{:name :action/update-booking}],
   :from :state/active,
   :to :state/active,
   :privileged? true}
  {:name :transition/payment-overdue,
   :actor :actor.role/operator,
   :actions [],
   :from :state/active,
   :to :state/payment-overdue,
   :privileged? true}
  {:name :transition/reactivate-subscription,
   :actor :actor.role/operator,
   :actions [{:name :action/update-booking}],
   :from :state/payment-overdue,
   :to :state/active,
   :privileged? true}
  {:name :transition/expire,
   :actor :actor.role/operator,
   :actions [{:name :action/cancel-booking}],
   :from :state/payment-overdue,
   :to :state/expired,
   :privileged? true}
  {:name :transition/cancel-subscription,
   :actor :actor.role/operator,
   :actions [{:name :action/cancel-booking}],
   :from :state/active,
   :to :state/cancelled,
   :privileged? true}
  {:name :transition/cancel-subscription-from-overdue,
   :actor :actor.role/operator,
   :actions [{:name :action/cancel-booking}],
   :from :state/payment-overdue,
   :to :state/cancelled,
   :privileged? true}],
 :notifications
 [{:name :notification/subscription-request-received-customer,
   :on :transition/confirm-payment,
   :to :actor.role/customer,
   :template :subscription-request-received-customer}
  {:name :notification/subscription-requested-provider,
   :on :transition/confirm-payment,
   :to :actor.role/provider,
   :template :subscription-requested-provider}
  {:name :notification/subscription-accepted-customer,
   :on :transition/accept-subscription,
   :to :actor.role/customer,
   :template :subscription-confirmed-customer}
  {:name :notification/subscription-accepted-provider,
   :on :transition/accept-subscription,
   :to :actor.role/provider,
   :template :subscription-accepted-provider}
  {:name :notification/subscription-declined-customer,
   :on :transition/decline-subscription,
   :to :actor.role/customer,
   :template :subscription-declined-customer}
  {:name :notification/subscription-declined-provider,
   :on :transition/decline-subscription,
   :to :actor.role/provider,
   :template :subscription-declined-provider}
  {:name :notification/subscription-acceptance-expired-customer,
   :on :transition/expire-acceptance,
   :to :actor.role/customer,
   :template :subscription-acceptance-expired-customer}
  {:name :notification/subscription-acceptance-expired-provider,
   :on :transition/expire-acceptance,
   :to :actor.role/provider,
   :template :subscription-acceptance-expired-provider}
  {:name :notification/subscription-aborted-customer,
   :on :transition/abort-subscription,
   :to :actor.role/customer,
   :template :subscription-aborted-customer}
  {:name :notification/subscription-aborted-provider,
   :on :transition/abort-subscription,
   :to :actor.role/provider,
   :template :subscription-aborted-provider}
  {:name :notification/subscription-confirmed-customer,
   :on :transition/confirm-subscription,
   :to :actor.role/customer,
   :template :subscription-confirmed-customer}
  {:name :notification/subscription-confirmed-provider,
   :on :transition/confirm-subscription,
   :to :actor.role/provider,
   :template :subscription-confirmed-provider}
  {:name :notification/subscription-renewed-customer,
   :on :transition/extend-subscription,
   :to :actor.role/customer,
   :template :subscription-renewed-customer}
  {:name :notification/subscription-payment-failed,
   :on :transition/payment-overdue,
   :to :actor.role/customer,
   :template :subscription-payment-failed}
  {:name :notification/subscription-payment-failed-provider,
   :on :transition/payment-overdue,
   :to :actor.role/provider,
   :template :subscription-payment-failed-provider}
  {:name :notification/subscription-reactivated-customer,
   :on :transition/reactivate-subscription,
   :to :actor.role/customer,
   :template :subscription-reactivated-customer}
  {:name :notification/subscription-reactivated-provider,
   :on :transition/reactivate-subscription,
   :to :actor.role/provider,
   :template :subscription-reactivated-provider}
  {:name :notification/subscription-cancelled-customer,
   :on :transition/cancel-subscription,
   :to :actor.role/customer,
   :template :subscription-cancelled}
  {:name :notification/subscription-cancelled-provider,
   :on :transition/cancel-subscription,
   :to :actor.role/provider,
   :template :subscription-cancelled}
  {:name :notification/subscription-cancelled-from-overdue-customer,
   :on :transition/cancel-subscription-from-overdue,
   :to :actor.role/customer,
   :template :subscription-cancelled-from-overdue-customer}
  {:name :notification/subscription-cancelled-from-overdue-provider,
   :on :transition/cancel-subscription-from-overdue,
   :to :actor.role/provider,
   :template :subscription-cancelled-from-overdue-provider}
  {:name :notification/subscription-expired-customer,
   :on :transition/expire,
   :to :actor.role/customer,
   :template :subscription-expired}
  {:name :notification/subscription-expired-provider,
   :on :transition/expire,
   :to :actor.role/provider,
   :template :subscription-expired}]}
